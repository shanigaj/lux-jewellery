# ─────────────────────────────────────────────────────────────
# Sparenza & Co. — Frontend environment (public vars)
# Copy to `.env.local` for local dev, and set the same keys in the
# Vercel dashboard (Settings → Environment Variables) for production.
#
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME — after changing any
# of them in Vercel you must trigger a redeploy for it to take effect.
# ─────────────────────────────────────────────────────────────

# Canonical production origin. Drives every canonical URL, sitemap
# entry, robots host, and JSON-LD @id. MUST be the exact live origin
# with scheme and NO trailing slash. A wrong value silently poisons
# SEO sitewide.
#   prod: https://sparenza.com
#   dev : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://sparenza.com

# Base URL of the Express API (include the /api suffix).
#   prod: https://sparenza-api.onrender.com/api
#   dev : http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# WhatsApp number in international format (used by the inquiry button).
NEXT_PUBLIC_WHATSAPP_NUMBER=+916353784310

# Cloudinary cloud name (unsigned client-side image URLs).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=k9nqbfzp

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Leave blank/unset to disable analytics entirely (no scripts load).
NEXT_PUBLIC_GA_ID=

# Google Search Console verification code (the value inside content="…" from
# GSC's "HTML tag" verification method). Renders a <meta name="google-site-
# verification"> tag so you can verify domain ownership and submit the sitemap.
# Leave blank if you verify via DNS (Cloudflare TXT record) instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
