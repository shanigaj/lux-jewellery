{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sparenza-web",
  "compatibility_date": "2025-03-20",
  // nodejs_compat: Next.js server runtime. global_fetch_strictly_public: server-side
  // fetch() calls go out to the public internet (required by OpenNext).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers KV incremental cache for OpenNext (ISR/SSG page cache). Free tier,
  // no billing required. Used by open-next.config.ts (kvIncrementalCache +
  // enableCacheInterception) to serve cached pages without a full re-render,
  // cutting Worker CPU and preventing Error 1102 on the free plan.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "47a3c6a020694d6eac47f831bf2e76bf"
    }
  ],
  // Custom domains — the storefront is served at the apex and www.
  "routes": [
    { "pattern": "sparenza.com", "custom_domain": true },
    { "pattern": "www.sparenza.com", "custom_domain": true }
  ]
}
